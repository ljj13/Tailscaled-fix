#!/system/bin/sh
# `tailscale` CLI wrapper. Adds the default socket and blocks the self-updater.
. /data/adb/tailscale/settings.ini

# Explicit hostname intent is permanent, including resetting to an empty name.
# Wait for an in-flight initializer before executing the user's command so the
# manual value wins. Other commands retain their exec/socket behavior.
for _arg in "$@"; do
  case "$_arg" in
    --hostname|--hostname=*|-hostname|-hostname=*)
      "${tailscale_dir:-/data/adb/tailscale}/bin/android-hostname" protect "${tailscale_dir:-/data/adb/tailscale}" || exit 1
      break ;;
  esac
done

case "$1" in
  update)
    echo "tailscale update is disabled in this module." >&2
    echo "" >&2
    echo "It would download the official GOOS=linux build, which activates" >&2
    echo "Tailscale's osrouter (fwmark + 'lookup main' + ts-* iptables chains)." >&2
    echo "Android has no usable 'main' route, so the control plane fails with" >&2
    echo "'network is unreachable' and the link is blocked." >&2
    echo "" >&2
    echo "Update the module instead, or rebuild it from source." >&2
    exit 1
    ;;
esac

if echo "$@" | grep -q -- '--socket='; then
  # An explicit socket was passed: use the arguments as-is.
  exec "${tailscale_bin}" "$@"
fi

exec "${tailscale_bin}" ${tailscale_bin_param} "$@"
